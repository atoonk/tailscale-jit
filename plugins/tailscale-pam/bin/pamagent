#!/bin/sh
# Runs the prebuilt pamagent for this OS and CPU.
set -e
dir=$(cd "$(dirname "$0")/.." && pwd)
os=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *) echo "pamagent: unsupported CPU $(uname -m)" >&2; exit 1 ;;
esac
bin="$dir/libexec/$os-$arch/pamagent"
if [ ! -x "$bin" ]; then
  echo "pamagent: no prebuilt binary for $os-$arch in $dir/libexec" >&2
  exit 1
fi
exec "$bin" "$@"
